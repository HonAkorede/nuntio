# Copy this file to .env for local development. Never commit .env.
# On your host, set these in its dashboard as environment variables instead.
# API keys and passwords only ever go in .env or the host's settings, never in code.

# Port the server listens on. Most hosts set this for you.
PORT=3000

# development or production
NODE_ENV=development

# Postgres connection string. Not needed until Phase 2 (launch feed).
# DATABASE_URL=

# Random string of at least 16 characters. Vercel sends it with each scheduled feed update.
# CRON_SECRET=

# Elysium RPC used by the server. Defaults to the official public RPC.
# ELYSIUM_RPC_URL=https://rpc.elysium.kinetiq.xyz
